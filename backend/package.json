    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node database/seed.js",
    "migrate": "node-pg-migrate up --envPath .env -m database/migrations",
    "migrate:down": "node-pg-migrate down --envPath .env -m database/migrations",
    "migrate:create": "node-pg-migrate create --envPath .env -m database/migrations -j js"
  },
