PORT=5000

# Supabase: Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
# Use the service_role key (secret, server-only). Never put it in the frontend.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Only used by `npm run migrate` (schema changes), not needed on the deployed server.
# Supabase: click "Connect" > Session pooler. URL-encode special characters in the password (@ # / :).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Any long random string. In production (NODE_ENV=production) it must be at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Allowed frontend origin(s) for CORS. Separate several with commas, no trailing slash needed.
# Required in production: set it to the deployed Vercel URL.
CLIENT_URL=http://localhost:5173

# Optional: maximum members per group (default 10)
# GROUP_MAX_SIZE=10
